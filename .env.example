# Copy to .env and fill in. Never commit .env.
NANO_API_KEY=np_live_...

# Shared secret NanoRelay sends back when it calls /refresh.
# Generate with: openssl rand -hex 24
REFRESH_SECRET=change-me

# Where this app is reachable from the internet. NanoRelay only calls public
# HTTPS endpoints, so this must be a real hostname with a certificate.
PUBLIC_URL=https://marketwatch.example.com

PORT=8080

# Only when a reverse proxy mounts the app under a path, e.g. /marketwatch.
# Leave empty when it has its own hostname.
BASE_PATH=

# Until Relay can reach you, let the app poll itself. Set to 0 in production
# so Relay is the only scheduler.
FALLBACK_POLL_SECONDS=0

# Proof of life, independent of the refresh cycle. The Pulse monitor window is
# set from this by setup.mjs. 0 turns it off.
HEARTBEAT_SECONDS=30

# When quotes are older than this, the heartbeat reports a failure - the
# process is alive but the data is not. Keep it above the refresh interval.
STALE_AFTER_SECONDS=1200

# One webhook, three senders. setup.mjs puts it on the Pulse monitor (pings
# stopped) and on the Relay schedule (the call failed); the app itself posts
# here when a price moves past the threshold in NanoConfig. Must be https.
ALERT_WEBHOOK_URL=

# Renders are counted in memory and written once per interval instead of once
# per request. The page reloads itself every 30s, so one write per render would
# make this demo the heaviest writer on the database it shares with everyone
# else. 0 disables render counting entirely.
COUNT_FLUSH_SECONDS=60

# A second key, read-only, used by /panel and nothing else. Create it with the
# key above; it cannot create one for itself:
#   curl -X POST https://pulse.nano-api.com/v1/keys \
#     -H "Authorization: Bearer $NANO_API_KEY" -H 'content-type: application/json' \
#     -d '{"name":"marketwatch panel","scope":"read"}'
# Leave empty and /panel says so rather than falling back to the write key.
NANO_READ_KEY=
